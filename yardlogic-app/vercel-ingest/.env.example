# Google Cloud service account with BigQuery Data Editor on the
# khatabook dataset. Create at:
# console.cloud.google.com/iam-admin/serviceaccounts

BIGQUERY_PROJECT_ID="your-gcp-project-id"
BIGQUERY_DATASET="khatabook"
GOOGLE_CLIENT_EMAIL="khatabook-ingest@your-gcp-project-id.iam.gserviceaccount.com"
# Paste the private_key from the service account JSON key file.
# Keep the \n literal — the code un-escapes them at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQ...\n-----END PRIVATE KEY-----\n"

# Shared secret your Apps Script sends as the X-Ingest-Secret header.
# Generate any long random string — this is the only thing stopping
# a stranger from writing rows into your BigQuery tables.
INGEST_SHARED_SECRET="generate-a-long-random-string-here"
