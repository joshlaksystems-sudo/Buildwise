# ===== DATABASE (Neon PostgreSQL) =====
# Get this from your Neon project dashboard → Connection Details.
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# ===== GOOGLE CLOUD CONFIGURATION =====
# Your GCP Project ID
GOOGLE_CLOUD_PROJECT_ID="project-92b2b5ff-5a11-4df5-a0d"

# Path to service account JSON key (download from GCP Console)
# IMPORTANT: Add this file to .gitignore!
GOOGLE_APPLICATION_CREDENTIALS="./buildwise-key.json"

# Cloud Storage bucket for invoice storage
GCS_BUCKET="docuvault-invoices"

# BigQuery dataset for analytics
BIGQUERY_DATASET="gst_transactions"
BIGQUERY_REGION="asia-southeast1"

# ===== VERTEX AI CONFIGURATION =====
# Enable Vertex AI features (expense categorization, reports, insights)
VERTEX_AI_ENABLE="true"

# Vertex AI location
VERTEX_AI_LOCATION="asia-southeast1"

# Vertex AI model ID
VERTEX_AI_MODEL_ID="gemini-1.5-pro"

# Require active subscription for AI features
VERTEX_AI_SUBSCRIPTION_REQUIRED="false"

# ===== AUTHENTICATION =====
# JWT secret for token generation (change to random 32+ character string)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Anthropic API key (optional, for fallback AI)
ANTHROPIC_API_KEY="sk-ant-..."

# ===== SERVER CONFIGURATION =====
PORT=4000
NODE_ENV="development"

# ===== COMPANY BRANDING =====
COMPANY_NAME="JC Nexus"
PRODUCT_NAME="Buildwise"
INVOICES_PREFIX="BW"

# ===== GST & COMPLIANCE =====
# GST filing / e-invoice / e-way bill — only needed once you've
# signed up with a licensed GSP (ClearTax, Zoho, Vayana, Cygnet).
GSP_API_KEY=""
GSP_BASE_URL=""

# ===== PAYMENT GATEWAY (Optional) =====
# Payment gateway — only needed to accept live UPI/card payments
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
