generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["ibim"]
}

enum OrganizationRole {
  ADMIN
  STAFF_DETAILER
  CLIENT
  ENGINEER_TRAINEE
  @@schema("ibim")
}

enum ProjectStatus {
  LEAD
  IN_PROGRESS
  REVISION_REQUESTED
  COMPLETED
  @@schema("ibim")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  @@schema("ibim")
}

enum DeliveryType {
  GA_DRAWING
  SHOP_DRAWING
  IFC_MODEL
  NC_DSTV
  PRECAST_DETAILING
  OTHER
  @@schema("ibim")
}

model Organization {
  id String @id @default(uuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members OrganizationMember[]
  projects Project[]
  tools TeklaTool[]
  courses Course[]
  candidates Candidate[]
  auditLogs AuditLog[]
  outboxEvents OutboxEvent[]
  timeEntries TimeEntry[]
  @@schema("ibim")
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  phone String?
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  memberships OrganizationMember[]
  projects Project[] @relation("ProjectClient")
  assignedTasks Task[] @relation("TaskAssignee")
  timeEntries TimeEntry[]
  toolLicenses ToolLicense[]
  registrations CourseRegistration[]
  payments PaymentLedger[]
  sessions RefreshSession[]
  auditLogs AuditLog[]
  @@schema("ibim")
}

model OrganizationMember {
  id String @id @default(uuid())
  organizationId String
  userId String
  role OrganizationRole @default(CLIENT)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
  @@schema("ibim")
}

model Project {
  id String @id @default(uuid())
  organizationId String
  clientId String
  title String
  projectType String
  status ProjectStatus @default(LEAD)
  estimatedHours Decimal @db.Decimal(10, 2)
  actualHours Decimal @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client User @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  tasks Task[]
  deliveries Delivery[]
  @@index([organizationId, status])
  @@index([clientId])
  @@schema("ibim")
}

model Task {
  id String @id @default(uuid())
  projectId String
  assigneeId String?
  title String
  hoursLogged Decimal @default(0) @db.Decimal(10, 2)
  isCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  @@index([projectId, isCompleted])
  @@schema("ibim")
}

model TimeEntry {
  id String @id @default(uuid())
  organizationId String
  taskId String
  userId String
  idempotencyKey String
  startedAt DateTime
  endedAt DateTime?
  minutes Int
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startedAt])
  @@index([userId, startedAt])
  @@index([taskId, startedAt])
  @@schema("ibim")
}

model Delivery {
  id String @id @default(uuid())
  projectId String
  type DeliveryType
  version Int @default(1)
  fileKey String
  checksum String
  approvedAt DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, type, version])
  @@index([projectId, createdAt])
  @@schema("ibim")
}

model TeklaTool {
  id String @id @default(uuid())
  organizationId String
  name String
  slug String @unique
  teklaVersion String
  priceAud Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  licenses ToolLicense[]
  @@schema("ibim")
}

model ToolLicense {
  id String @id @default(uuid())
  licenseKey String @unique
  signedPayload String
  hardwareHash String?
  toolId String
  userId String
  expiresAt DateTime?
  revokedAt DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  tool TeklaTool @relation(fields: [toolId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, isActive])
  @@schema("ibim")
}

model PaymentLedger {
  id String @id @default(uuid())
  stripeTransactionId String @unique
  idempotencyKey String @unique
  amount Decimal @db.Decimal(12, 2)
  currency String @default("AUD")
  status PaymentStatus @default(PENDING)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@schema("ibim")
}

model Course {
  id String @id @default(uuid())
  organizationId String
  name String
  slug String @unique
  isActive Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registrations CourseRegistration[]
  @@schema("ibim")
}

model CourseRegistration {
  id String @id @default(uuid())
  courseId String
  userId String
  registeredAt DateTime @default(now())
  completedAt DateTime?
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([courseId, userId])
  @@schema("ibim")
}

model Candidate {
  id String @id @default(uuid())
  organizationId String
  name String
  email String?
  resumeObjectKey String?
  resumeChecksum String?
  parsedProfile Json?
  embeddingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
  @@schema("ibim")
}

model RefreshSession {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@schema("ibim")
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  userId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@schema("ibim")
}

model OutboxEvent {
  id String @id @default(uuid())
  organizationId String
  eventType String
  aggregateType String
  aggregateId String
  dedupeKey String @unique
  payload Json
  publishedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([publishedAt, createdAt])
  @@index([organizationId, createdAt])
  @@schema("ibim")
}
